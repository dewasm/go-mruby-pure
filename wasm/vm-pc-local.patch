+/**** dewasm experiment: the program counter cached in a local ****/
+/* mrb_vm_exec() keeps the program counter of the running frame in `vmpc` and
+ * writes it back to ci->pc at every point where other code can observe it.
+ * PC_SYNC() makes ci->pc current, PC_RELOAD() adopts a ci->pc set elsewhere,
+ * PC_SET() stores a new value in both. All three are only usable inside
+ * mrb_vm_exec(), where `ci` and `vmpc` are in scope. */
+#define PC_SYNC()   (ci->pc = vmpc)
+#define PC_RELOAD() (vmpc = ci->pc)
+#define PC_SET(p)   (ci->pc = vmpc = (p))
+
+/* SET_INT_VALUE() heap-allocates outside the fixnum range under word and NaN
+ * boxing, so the allocating half needs a synced ci->pc; the fixnum half is the
+ * one the CASE_F() opcodes are kept call-free for. */
+#define PC_SET_INT_VALUE(mrb, r, n) do {                                    \
+  mrb_int pc_int_value_ = (n);                                              \
+  if (mrb_likely(FIXABLE(pc_int_value_))) {                                 \
+    SET_FIXNUM_VALUE(r, pc_int_value_);                                     \
+  }                                                                         \
+  else {                                                                    \
+    PC_SYNC();                                                              \
+    SET_INT_VALUE(mrb, r, pc_int_value_);                                   \
+  }                                                                         \
+} while (0)
